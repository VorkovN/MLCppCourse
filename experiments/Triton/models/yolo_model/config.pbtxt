name: "yolo_model"
platform: "onnxruntime_onnx"
max_batch_size: 0

# Ultralytics YOLO (ONNX) по умолчанию экспортируется с фиксированным batch=1:
# - input:  images  [1, 3, 640, 640] FP32
# - output: output0 [1, 84, 8400]   FP32  (4 + nc, num)
# Поэтому batching в Triton выключаем (max_batch_size: 0).
input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [1, 3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [1, 84, 8400]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]